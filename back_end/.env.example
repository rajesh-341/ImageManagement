PORT=5000

# Replace with a secure random string for production
JWT_SECRET=your_jwt_secret_key_here

FRONTEND_URL=http://localhost:3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=imagemanagement
# Set to "false" for local dev, omit or set "true" for production (Heroku, etc.)
DB_SSL=false

# Storage backend: "local" for local filesystem, "r2" for Cloudflare R2 (omit for R2)
STORAGE_TYPE=r2

# Cloudflare R2 Configuration
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_bucket_name
# Optional: Custom public URL for R2 (e.g., https://images.yourdomain.com)
# If not set, the R2 endpoint + bucket name will be used as the base URL
R2_PUBLIC_URL=

PORT=5000

# Replace with a secure random string for production
JWT_SECRET=your_jwt_secret_key_here

FRONTEND_URL=http://localhost:3000

DB_HOST=localhost
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=imagemanagement
# Set to "false" for local dev, omit or set "true" for production (Heroku, etc.)
DB_SSL=false

# Storage backend: "local" for local filesystem, omit for Cloudinary
STORAGE_TYPE=local

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
